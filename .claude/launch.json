{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5199",
        "--strictPort"
      ],
      "env": {
        "VITE_BACKEND_PROXY_TARGET": "http://127.0.0.1:8018"
      }
    },
    {
      "name": "frontend-dev-userdb",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5199",
        "--strictPort"
      ],
      "env": {
        "VITE_BACKEND_PROXY_TARGET": "http://127.0.0.1:8008"
      }
    }
  ]
}