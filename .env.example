# ===== 基础 =====
# 服务监听端口（docker compose 的宿主机端口也用它）
PORT=8008
APP_NAME=视频生成工作台
# 生产环境务必换成随机字符串：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=please-change-this-secret
TOKEN_EXPIRE_MINUTES=10080

# ===== 管理员账号（首次启动时自动创建）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== 视频模型 API 通道 =====
# wan3.0-video-prime 与 MiniMax/MiniMax-H3 共用
DASHSCOPE_API_KEY_WAN=sk-xxxxxxxxxxxxxxxx
# HappyHorse 系列优先使用此专用 Key。明确提示余额/额度不足时，自动回退到上面的 Wan/MiniMax 通道。
DASHSCOPE_API_KEY_HAPPYHORSE=sk-yyyyyyyyyyyyyyyy
# HappyHorse 专用 Token Plan 入口。异步视频任务会使用同一地域主机的 DashScope 任务路径。
HAPPYHORSE_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Wan 3 / MiniMax 的共享任务入口。留空使用 https://dashscope.aliyuncs.com。
DASHSCOPE_BASE_URL=


# ===== 域名与反向代理 =====
# 只填 APP_DOMAIN，下面三项都会自动推导出来（也可以单独覆盖）
# 例：video.example.com     注意不要带 http:// 和结尾的 /
APP_DOMAIN=

# 域名是否已配好 HTTPS 证书。true 时 PUBLIC_BASE_URL 推导为 https://<APP_DOMAIN>
USE_HTTPS=true

# 对外完整地址，供阿里云回源下载参考图。留空则由 APP_DOMAIN + USE_HTTPS 推导。
#
# 【没有域名也可以填】这里要的是「阿里云能访问到的地址」，公网 IP 同样有效：
#   PUBLIC_BASE_URL=http://你的公网IP:8008      （记得安全组放行该端口）
# 不填的话，wan 与 happyhorse 会自动改用 Base64 直传，只有 MiniMax 用不了图片上传。
# 填成 localhost / 192.168.x.x / 10.x.x.x 等内网地址会被识别为不可用，自动回退 Base64。
PUBLIC_BASE_URL=

# 允许跨域调用 API 的来源，逗号分隔。留空 = 只允许同源（推荐）
# 前后端同域部署时保持留空即可；前端单独部署到别的域名才需要填
ALLOWED_ORIGINS=

# 允许的 Host 请求头，逗号分隔。留空则由 APP_DOMAIN 推导，用于防 Host 头注入
TRUSTED_HOSTS=

# 是否运行在 Nginx / Caddy 等反向代理后面。
# 开启后会信任 X-Forwarded-For 取真实客户端 IP（限流用），
# 同时 uvicorn 需要加 --proxy-headers（compose 里已配好）
BEHIND_PROXY=false

# 强制 HTTPS 跳转 + HSTS。仅在证书已生效后再打开，否则会把自己锁在门外
FORCE_HTTPS=false

# ===== 登录保护 =====
# 同一账号或同一 IP 连续失败多少次后锁定
LOGIN_MAX_ATTEMPTS=8
# 锁定时长（秒）
LOGIN_LOCKOUT_SECONDS=300

# ===== 生成参数 =====
MAX_VIDEO_DURATION=15
POLL_INTERVAL_SECONDS=8
POLL_TIMEOUT_SECONDS=1800
DOWNLOAD_VIDEOS=true
MAX_UPLOAD_MB=20
# 媒体签名链接有效期（秒）。视频和参考图的访问链接过期后自动失效，
# 太短会导致页面开久了点播放需要刷新，默认 6 小时
MEDIA_LINK_TTL_SECONDS=21600

# ===== 磁盘清理 =====
# 生成的视频保留天数，超期自动删除视频文件（对话记录、提示词、参数都保留）
# 设为 0 或负数则关闭自动清理
VIDEO_RETENTION_DAYS=7
# 清理任务运行间隔（小时）。服务启动时也会先跑一次
CLEANUP_INTERVAL_HOURS=6

# ===== 多轮对话记忆 =====
# 上下文记忆统一使用 AGENT_DEFAULT_MODEL 的模型、URL 和 Key，不再单独配置模型
CONTEXT_ENABLED=true
CONTEXT_MAX_TURNS=6

# ===== 创作智能体 =====
AGENT_ENABLED=true
# 多模型目录优先。api_key_env 指向单独的环境变量，目录本身不保存密钥。
AGENT_MODELS_JSON=[]
AGENT_DEFAULT_MODEL=
AGENT_KEY_QWEN_PLUS=
# 单模型兼容配置：未设置 AGENT_MODELS_JSON 时使用；AGENT_API_KEY 留空则复用 DASHSCOPE_API_KEY_WAN。
AGENT_PROVIDER=openai
AGENT_BASE_URL=
AGENT_MODEL=qwen-plus
AGENT_API_KEY=
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=2048
AGENT_TIMEOUT_SECONDS=60
AGENT_AUTONOMY=confirm
AGENT_MAX_AUTO_COST=20
AGENT_MAX_AUTO_NODES=3
AGENT_DAILY_COST_LIMIT=200
AGENT_PRICE_DEFAULT=0.8
AGENT_PRICE_TABLE=
AGENT_CURRENCY=CNY
AGENT_RATE_PER_MINUTE=6
AGENT_DAILY_TOKEN_LIMIT=200000
AGENT_PLAN_TTL_MINUTES=60
AGENT_MAX_REPAIR_ATTEMPTS=2
AGENT_MAX_HISTORY_TURNS=8
AGENT_FALLBACK_RULES=true

# ===== 存储 =====
DATA_DIR=./data
